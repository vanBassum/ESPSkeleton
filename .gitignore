# macOS
.DS_Store
.AppleDouble
.LSOverride

# Directory metadata
.directory

# Temporary files
*~
*.swp
*.swo
*.bak
*.tmp

# Log files
*.log

# Build artifacts and directories
**/build/
build/
# Per-board build trees (idf.py -B build_c3 ...)
build_*/
*.o
*.a
*.out
*.exe # For any host-side utilities compiled on Windows

# ESP-IDF specific build outputs
*.bin
*.elf
*.map
flasher_args.json # Generated in build directory
sdkconfig
# ...including the per-board configs (idf.py -D SDKCONFIG=sdkconfig.c3 ...).
# The board overlays checked into main/hardware/boards/<name>/ are not these.
sdkconfig.*
!sdkconfig.defaults

# ESP-IDF dependencies
# For older versions or manual component management
/components/.idf/
**/components/.idf/
# For modern ESP-IDF component manager
managed_components/
dependencies.lock
# If ESP-IDF tools are installed/referenced locally to the project
.espressif/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake

# Python environment files
*.pyc
*.pyo
*.pyd
__pycache__/
*.egg-info/
dist/

# Virtual environment folders
venv/
.venv/
env/

# Language Servers
.clangd
.clangd/
.ccls-cache/
compile_commands.json

# Windows specific
Thumbs.db
ehthumbs.db
Desktop.ini

# User-specific configuration files
*.user
*.workspace # General workspace files, can be from various tools
*.suo       # Visual Studio Solution User Options
*.sln.docstates # Visual Studio

# Frontend
frontend/node_modules/
frontend/.pnpm-store/

# Frontend build output (baked into firmware via FAT image)
www/

# IDE
.vscode/
.idea/

# Claude Code — skills, slash commands and shared settings are part of the repo
# (forks inherit them); personal settings and runtime state are not.
# NOTE: must be `.claude/*`, not `.claude/`, or git will not descend to see the
# negations below.
.claude/*
!.claude/skills/
!.claude/commands/
!.claude/settings.json

# Generated by the graphify skill — a rebuildable knowledge graph, not source.
graphify-out/
